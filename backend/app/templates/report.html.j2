<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #1e293b; margin: 0; padding: 24px; background: #f8fafc; }
  .card { max-width: 680px; margin: 0 auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
  .head { padding: 20px 24px; background: #0f172a; color: #fff; }
  .head h1 { margin: 0; font-size: 18px; }
  .head p { margin: 4px 0 0; font-size: 13px; color: #94a3b8; }
  .section { padding: 16px 24px; border-top: 1px solid #e2e8f0; }
  .kpis { display: flex; gap: 12px; flex-wrap: wrap; }
  .kpi { flex: 1; min-width: 140px; background: #f1f5f9; border-radius: 8px; padding: 12px; }
  .kpi .label { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #64748b; }
  .kpi .value { font-size: 18px; font-weight: 600; margin-top: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid #eef2f7; }
  th { color: #64748b; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }
  td.amount, th.amount { text-align: right; font-variant-numeric: tabular-nums; }
  .muted { color: #94a3b8; }
  .foot { padding: 16px 24px; font-size: 11px; color: #94a3b8; border-top: 1px solid #e2e8f0; }
</style>
</head>
<body>
  <div class="card">
    <div class="head">
      <h1>Kharcha Tracker — Expense Report</h1>
      <p>{{ user.name }} &nbsp;·&nbsp; {{ range.start.strftime('%d %b %Y') }} – {{ range.end.strftime('%d %b %Y') }}</p>
    </div>

    <div class="section">
      <div class="kpis">
        <div class="kpi"><div class="label">Total spent</div><div class="value">{{ inr(summary.total) }}</div></div>
        <div class="kpi"><div class="label">Transactions</div><div class="value">{{ summary.transaction_count }}</div></div>
        <div class="kpi"><div class="label">Top category</div><div class="value">
          {% if summary.top_category %}{{ summary.top_category.label }}{% else %}<span class="muted">—</span>{% endif %}
        </div></div>
      </div>
    </div>

    <div class="section">
      <h3>By category</h3>
      <table>
        <tr><th>Category</th><th class="amount">Amount</th></tr>
        {% for row in summary.by_category %}
        <tr><td>{{ row.label }}</td><td class="amount">{{ inr(row.total) }}</td></tr>
        {% else %}
        <tr><td class="muted" colspan="2">No spend in this range.</td></tr>
        {% endfor %}
      </table>
    </div>

    <div class="section">
      <h3>By payment mode</h3>
      <table>
        <tr><th>Mode</th><th class="amount">Amount</th></tr>
        {% for row in summary.by_payment_mode %}
        <tr><td>{{ row.label }}</td><td class="amount">{{ inr(row.total) }}</td></tr>
        {% else %}
        <tr><td class="muted" colspan="2">No spend in this range.</td></tr>
        {% endfor %}
      </table>
    </div>

    <div class="section">
      <h3>All transactions ({{ transactions|length }})</h3>
      <table>
        <tr><th>Date</th><th>Category</th><th>Payment</th><th>Note</th><th class="amount">Amount</th></tr>
        {% for t in transactions %}
        <tr>
          <td>{{ t.transaction_date.strftime('%d %b') }}</td>
          <td>{{ cat_label(t.category) }}</td>
          <td>{{ pay_label(t.payment_mode) }}</td>
          <td class="muted">{{ t.note or '' }}</td>
          <td class="amount">{{ inr(t.amount) }}</td>
        </tr>
        {% else %}
        <tr><td class="muted" colspan="5">No transactions in this range.</td></tr>
        {% endfor %}
      </table>
    </div>

    <div class="foot">
      Generated by Kharcha Tracker on {{ generated_at.strftime('%d %b %Y %H:%M UTC') }}. Amounts in ₹ INR.
    </div>
  </div>
</body>
</html>
