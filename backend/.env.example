# Copy to .env and fill in. Never commit .env.

# --- Database ---
# SQLite for local dev; Render provides a postgres:// URL in prod.
DATABASE_URL=sqlite:///./kharcha.db

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth client id (see docs/credentials-setup.md). Leave blank while DEV_AUTH=true.
GOOGLE_CLIENT_ID=

# Dev fallback: when true, /auth/dev-login works and emails are written to outbox/ not sent.
DEV_AUTH=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- SMTP (emailed reports) — see docs/credentials-setup.md. Leave blank while DEV_AUTH=true. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=Kharcha Tracker <you@gmail.com>
